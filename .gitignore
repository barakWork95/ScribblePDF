*.log
npm-debug.log*
.cache/
*.tsbuildinfo

# Secrets — never commit. Web Store publishing keys live here.
.env
.env.*
*.pem
key.pem
*.p12

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
*.swp
