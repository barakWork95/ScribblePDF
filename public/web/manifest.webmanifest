{
  "name": "ScribblePDF — Annotate and sign PDFs",
  "short_name": "ScribblePDF",
  "description": "Add text, checkmarks, crosses and signatures to any PDF. 100% local — your files never leave your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f1f2f5",
  "theme_color": "#FF7F50",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "icons/icon128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "icons/icon128.png", "sizes": "128x128", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/pdf": [".pdf"] }
    }
  ]
}
